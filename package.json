{
  "name": "youth-bulletin-react",
  "version": "1.5.0",
  "private": true,
  "description": "React 청년부 주보 편집 앱",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "vite build",
    "start": "electron .",
    "test": "node --test electron/public.test.cjs",
    "build:native": "node scripts/build-native.cjs",
    "package:installer": "npm run build:native && npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.10",
    "cheerio": "^1.0.0",
    "electron-updater": "^6.8.11",
    "jszip": "^3.10.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "kr.youth.bulletin.react",
    "productName": "청년부 주보",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "electron/engine.cjs",
      "assets/template.pptx",
      "package.json",
      "electron/layout.cjs",
      "assets/legacy-defaults.json",
      "electron/export-files.cjs",
      "assets/birthdays-2026.json",
      "shared/birthdays.mjs",
      "electron/maintenance.cjs",
      "electron/updates.cjs"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "extraResources": [
      {
        "from": "assets/ValidatePpt.exe",
        "to": "ValidatePpt.exe"
      }
    ],
    "artifactName": "YouthBulletin-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "Mellow1213",
        "repo": "youth-bulletin",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "청년부 주보"
    }
  },
  "allowScripts": {
    "electron@41.10.7": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}